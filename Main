-- // Axiom's Universal Hitbox & Camera Aim Engine: "meo bị down"
-- // Supports Players & NPCs, Scalable Blue Hitboxes, Universal ESP, Bottom Snaplines.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local Config = {
    Enabled = true,
    Box = true,
    Snaplines = true,
    HealthBar = true,
    CameraAim = false,
    HitboxToggle = false,
    HitboxSize = 6, -- Scaled from old FOV value
    HitboxMin = 2,
    HitboxMax = 20,
    MenuOpen = true
}

-- // Cleanup old UI if it exists
if CoreGui:FindFirstChild("MeoBiDownOverlay") then
    CoreGui:FindFirstChild("MeoBiDownOverlay"):Destroy()
end

-- // Screen GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MeoBiDownOverlay"
ScreenGui.Parent = CoreGui
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false

-- // Floating Mobile Toggle Button
local OpenButton = Instance.new("TextButton")
OpenButton.Name = "OpenMenuBtn"
OpenButton.Size = UDim2.new(0, 50, 0, 50)
OpenButton.Position = UDim2.new(0, 10, 0.5, -25)
OpenButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
OpenButton.TextColor3 = Color3.fromRGB(255, 255, 255)
OpenButton.Text = "MEO"
OpenButton.Font = Enum.Font.GothamBold
OpenButton.TextSize = 14
OpenButton.Active = true
OpenButton.Draggable = true
OpenButton.Parent = ScreenGui

local OpenCorner = Instance.new("UICorner")
OpenCorner.CornerRadius = UDim.new(1, 0)
OpenCorner.Parent = OpenButton

-- // Main Menu Frame
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MenuFrame"
MainFrame.Size = UDim2.new(0, 260, 0, 340)
MainFrame.Position = UDim2.new(0.5, -130, 0.5, -170)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Visible = Config.MenuOpen
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = MainFrame

-- // Dynamic UI Layout
local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Parent = MainFrame
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 6)
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local UIPadding = Instance.new("UIPadding")
UIPadding.Parent = MainFrame
UIPadding.PaddingTop = UDim.new(0, 10)
UIPadding.PaddingBottom = UDim.new(0, 10)

-- // Title
local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, -20, 0, 30)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "meo bị down"
TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleLabel.TextSize = 18
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.LayoutOrder = 1
TitleLabel.Parent = MainFrame

-- // Toggle Logic for Menu
OpenButton.MouseButton1Click:Connect(function()
    Config.MenuOpen = not Config.MenuOpen
    MainFrame.Visible = Config.MenuOpen
end)

local LayoutCounter = 2

local function CreateToggle(name, initialState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.TextColor3 = initialState and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    btn.Text = name .. (initialState and ": ON" or ": OFF")
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.LayoutOrder = LayoutCounter
    LayoutCounter = LayoutCounter + 1
    btn.Parent = MainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    
    local state = initialState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = name .. (state and ": ON" or ": OFF")
        btn.TextColor3 = state and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
        callback(state)
    end)
end

local function CreateValueControl(name, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -20, 0, 30)
    container.BackgroundTransparency = 1
    container.LayoutOrder = LayoutCounter
    LayoutCounter = LayoutCounter + 1
    container.Parent = MainFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.Text = name .. ": " .. Config.HitboxSize
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, 30, 0, 24)
    minusBtn.Position = UDim2.new(1, -70, 0.5, -12)
    minusBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    minusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    minusBtn.Text = "-"
    minusBtn.Font = Enum.Font.GothamBold
    minusBtn.Parent = container
    
    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, 30, 0, 24)
    plusBtn.Position = UDim2.new(1, -35, 0.5, -12)
    plusBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    plusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    plusBtn.Text = "+"
    plusBtn.Font = Enum.Font.GothamBold
    plusBtn.Parent = container
    
    for _, b in ipairs({minusBtn, plusBtn}) do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 4)
        c.Parent = b
    end
    
    minusBtn.MouseButton1Click:Connect(function()
        Config.HitboxSize = math.clamp(Config.HitboxSize - 1, Config.HitboxMin, Config.HitboxMax)
        label.Text = name .. ": " .. Config.HitboxSize
        callback(Config.HitboxSize)
    end)
    
    plusBtn.MouseButton1Click:Connect(function()
        Config.HitboxSize = math.clamp(Config.HitboxSize + 1, Config.HitboxMin, Config.HitboxMax)
        label.Text = name .. ": " .. Config.HitboxSize
        callback(Config.HitboxSize)
    end)
end

-- // Build Interface Elements
CreateToggle("Box ESP", Config.Box, function(v) Config.Box = v end)
CreateToggle("Snaplines", Config.Snaplines, function(v) Config.Snaplines = v end)
CreateToggle("Health Bar", Config.HealthBar, function(v) Config.HealthBar = v end)
CreateToggle("Camera Aim", Config.CameraAim, function(v) Config.CameraAim = v end)
CreateToggle("Hitbox Mod", Config.HitboxToggle, function(v) Config.HitboxToggle = v end)
CreateValueControl("Hitbox Size", function(v) end)

-- // Universal Entity Collection (Players + NPCs)
local function GetValidEntities()
    local entities = {}
    
    -- Grab standard players
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local root = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("PrimaryPart")
            if hum and root and hum.Health > 0 then
                table.insert(entities, {Model = player.Character, Humanoid = hum, Root = root})
            end
        end
    end
    
    -- Grab NPCs across the workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("PrimaryPart") or obj:FindFirstChild("Head")
            -- Make sure it's not a player model already counted
            local isPlayer = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character == obj then isPlayer = true break end
            end
            if hum and root and not isPlayer and hum.Health > 0 then
                table.insert(entities, {Model = obj, Humanoid = hum, Root = root})
            end
        end
    end
    
    return entities
end

-- // ESP Draw Storage Cache
local EspCache = {}

local function RemoveEsp(model)
    if EspCache[model] then
        for _, obj in pairs(EspCache[model]) do
            pcall(function() obj:Remove() end)
        end
        EspCache[model] = nil
    end
end

local function CreateEsp(model)
    if EspCache[model] then return end
    local drawings = {
        Box = Drawing.new("Square"),
        Snapline = Drawing.new("Line"),
        Health = Drawing.new("Text")
    }
    
    drawings.Box.Visible = false
    drawings.Box.Thickness = 1
    drawings.Box.Color = Color3.fromRGB(255, 255, 255)
    drawings.Box.Filled = false
    
    drawings.Snapline.Visible = false
    drawings.Snapline.Thickness = 1
    drawings.Snapline.Color = Color3.fromRGB(255, 255, 255)
    
    drawings.Health.Visible = false
    drawings.Health.Size = 13
    drawings.Health.Color = Color3.fromRGB(0, 255, 0)
    drawings.Health.Center = true
    
    EspCache[model] = drawings
end

-- // Target Selection for Camera Aim (Closest, Wall-Checked, 360-Degree by default unless Hitbox restriction handles bounds)
local function GetOptimalTarget()
    if not Config.CameraAim then return nil end
    
    local screenCenter = Camera.ViewportSize / 2
    local bestTarget = nil
    local shortestDist = math.huge
    
    for _, entity in ipairs(GetValidEntities()) do
        local head = entity.Model:FindFirstChild("Head") or entity.Root
        if head then
            local vector, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                -- Wall-check raycast
                local ray = Ray.new(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * 500)
                local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, Camera})
                
                if hit and hit:IsDescendantOf(entity.Model) then
                    local screenDist = (Vector2.new(vector.X, vector.Y) - screenCenter).Magnitude
                    if screenDist < shortestDist then
                        shortestDist = screenDist
                        bestTarget = head
                    end
                end
            end
        end
    end
    return bestTarget
end

-- // Main Real-Time Render Engine
RunService.RenderStepped:Connect(function()
    local screenBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    
    -- Camera Aim Execution
    if Config.CameraAim then
        local targetHead = GetOptimalTarget()
        if targetHead then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
        end
    end

    local activeModels = {}

    for _, entity in ipairs(GetValidEntities()) do
        local model = entity.Model
        local humanoid = entity.Humanoid
        local root = entity.Root
        local head = model:FindFirstChild("Head") or root
        
        activeModels[model] = true
        CreateEsp(model)
        local cache = EspCache[model]

        -- Hitbox Expansion Modification (Blue Transparent Box sizing logic redirecting damage bounds)
        if Config.HitboxToggle then
            pcall(function()
                root.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                root.Transparency = 0.6
                root.Color = Color3.fromRGB(0, 120, 255)
                root.CanCollide = false
            end)
        else
            pcall(function()
                root.Transparency = 1 -- Revert transparency when toggled off
            end)
        end

        local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
        
        if onScreen and Config.Enabled then
            local headVector = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local legVector = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
            
            local height = math.abs(headVector.Y - legVector.Y)
            local width = height / 2
            
            -- Box ESP
            if Config.Box then
                cache.Box.Visible = true
                cache.Box.Size = Vector2.new(width, height)
                cache.Box.Position = Vector2.new(vector.X - width / 2, headVector.Y)
            else
                cache.Box.Visible = false
            end
            
            -- Bottom Snaplines
            if Config.Snaplines then
                cache.Snapline.Visible = true
                cache.Snapline.From = screenBottom
                cache.Snapline.To = Vector2.new(vector.X, vector.Y)
            else
                cache.Snapline.Visible = false
            end
            
            -- Health Display
            if Config.HealthBar then
                cache.Health.Visible = true
                cache.Health.Text = math.floor(humanoid.Health) .. " HP"
                cache.Health.Position = Vector2.new(vector.X, legVector.Y + 5)
            else
                cache.Health.Visible = false
            end
        else
            for _, obj in pairs(cache) do obj.Visible = false end
        end
    end

    -- Cleanup missing entities from cache
    for model, _ in pairs(EspCache) do
        if not activeModels[model] then
            RemoveEsp(model)
        end
    end
end)
