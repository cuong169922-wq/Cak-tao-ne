-- // Axiom's Fixed Center FOV & Metamethod Silent Aim Framework: "meo bị down"
-- // Optimized for stable screen-center geometry and low-level execution hooks.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer

-- // Configuration State
local Config = {
    Enabled = true,
    Box = true,
    Snaplines = true,
    HealthBar = true,
    SilentAim = false,
    FovToggle = false,
    FovRadius = 150,
    FovMin = 30,
    FovMax = 360,
}

-- // Menu GUI Creation ("meo bị down")
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MeoBiDownOverlay"
ScreenGui.Parent = CoreGui
ScreenGui.IgnoreGuiInset = true

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MenuFrame"
MainFrame.Size = UDim2.new(0, 260, 0, 340)
MainFrame.Position = UDim2.new(0.1, 0, 0.1, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = MainFrame

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 35)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "meo bị down"
TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleLabel.TextSize = 16
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Parent = MainFrame

-- // Resize Handle
local ResizeHandle = Instance.new("TextButton")
ResizeHandle.Size = UDim2.new(0, 15, 0, 15)
ResizeHandle.Position = UDim2.new(1, -15, 1, -15)
ResizeHandle.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
ResizeHandle.Text = ""
ResizeHandle.Parent = MainFrame

local resizing = false
ResizeHandle.MouseButton1Down:Connect(function() resizing = true end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then resizing = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
        local mousePos = UserInputService:GetMouseLocation()
        local newSizeX = math.clamp(mousePos.X - MainFrame.AbsolutePosition.X, 220, 500)
        local newSizeY = math.clamp(mousePos.Y - MainFrame.AbsolutePosition.Y, 280, 600)
        MainFrame.Size = UDim2.new(0, newSizeX, 0, newSizeY)
    end
end)

-- // Toggle Creator Helper
local function CreateToggle(name, yPos, initialState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 28)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.TextColor3 = initialState and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    btn.Text = name .. (initialState and ": ON" or ": OFF")
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = MainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    
    local state = initialState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = name .. (state and ": ON" or ": OFF")
        btn.TextColor3 = state and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
        callback(state)
    end)
end

-- // Classic Value Adjustment Button Controls (như cũ)
local function CreateValueControl(name, yPos, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 20)
    label.Position = UDim2.new(0, 10, 0, yPos)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.Text = name .. ": " .. Config.FovRadius
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = MainFrame
    
    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, 35, 0, 22)
    minusBtn.Position = UDim2.new(1, -75, 0, yPos)
    minusBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    minusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    minusBtn.Text = "-"
    minusBtn.Font = Enum.Font.GothamBold
    minusBtn.Parent = MainFrame
    
    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, 35, 0, 22)
    plusBtn.Position = UDim2.new(1, -35, 0, yPos)
    plusBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    plusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    plusBtn.Text = "+"
    plusBtn.Font = Enum.Font.GothamBold
    plusBtn.Parent = MainFrame
    
    for _, b in ipairs({minusBtn, plusBtn}) do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 4)
        c.Parent = b
    end
    
    minusBtn.MouseButton1Click:Connect(function()
        Config.FovRadius = math.clamp(Config.FovRadius - 15, Config.FovMin, Config.FovMax)
        label.Text = name .. ": " .. Config.FovRadius
        callback(Config.FovRadius)
    end)
    
    plusBtn.MouseButton1Click:Connect(function()
        Config.FovRadius = math.clamp(Config.FovRadius + 15, Config.FovMin, Config.FovMax)
        label.Text = name .. ": " .. Config.FovRadius
        callback(Config.FovRadius)
    end)
end

-- // Build Interface Elements
CreateToggle("Box ESP", 40, Config.Box, function(v) Config.Box = v end)
CreateToggle("Snaplines", 72, Config.Snaplines, function(v) Config.Snaplines = v end)
CreateToggle("Health Bar", 104, Config.HealthBar, function(v) Config.HealthBar = v end)
CreateToggle("Silent Aim", 136, Config.SilentAim, function(v) Config.SilentAim = v end)
CreateToggle("FOV Circle", 168, Config.FovToggle, function(v) Config.FovToggle = v end)
CreateValueControl("FOV Size", 204, function(v) end)

-- // FOV Circle Drawing Object (Fixed to Center of Screen)
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Filled = false
FOVCircle.Thickness = 1
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.NumSides = 64

-- // Storage for active ESP drawings per entity
local EspCache = {}

local function RemoveEsp(player)
    if EspCache[player] then
        for _, obj in pairs(EspCache[player]) do
            pcall(function() obj:Remove() end)
        end
        EspCache[player] = nil
    end
end

local function CreateEsp(player)
    if EspCache[player] then return end
    
    local drawings = {
        Box = Drawing.new("Square"),
        Snapline = Drawing.new("Line"),
        Health = Drawing.new("Text")
    }
    
    drawings.Box.Visible = false
    drawings.Box.Thickness = 1
    drawings.Box.Color = Color3.fromRGB(255, 255, 255)
    drawings.Box.Filled = false
    
    drawings.Snapline.Visible = false
    drawings.Snapline.Thickness = 1
    drawings.Snapline.Color = Color3.fromRGB(255, 255, 255)
    
    drawings.Health.Visible = false
    drawings.Health.Size = 12
    drawings.Health.Color = Color3.fromRGB(0, 255, 0)
    drawings.Health.Center = true
    
    EspCache[player] = drawings
end

Players.PlayerRemoving:Connect(RemoveEsp)

-- // Target Resolution Engine for 360-Degree Silent Aim with Center Screen FOV Check
local function GetOptimalTarget()
    if not Config.SilentAim then return nil end
    
    local screenCenter = Camera.ViewportSize / 2
    local bestTarget = nil
    local shortestDist = Config.FovToggle and math.clamp(Config.FovRadius, Config.FovMin, Config.FovMax) or math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local head = char.Head
                local vector, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local screenDist = (Vector2.new(vector.X, vector.Y) - screenCenter).Magnitude
                    if screenDist < shortestDist then
                        shortestDist = screenDist
                        bestTarget = head
                    end
                end
            end
        end
    end
    return bestTarget
end

-- // Low-Level Metamethod Hook for Bullet/Remote Redirection
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if Config.SilentAim and (method == "FireServer" or method == "InvokeServer") then
        local targetHead = GetOptimalTarget()
        if targetHead then
            for i, v in ipairs(args) do
                if typeof(v) == "Vector3" then
                    args[i] = targetHead.Position
                elseif typeof(v) == "Ray" then
                    args[i] = Ray.new(v.Origin, (targetHead.Position - v.Origin).Unit * v.Direction.Magnitude)
                end
            end
        end
    end
    
    return oldNamecall(self, unpack(args))
end)

-- // Main Real-Time Frame Render Loop
RunService.RenderStepped:Connect(function()
    local screenCenter = Camera.ViewportSize / 2
    
    -- Keep FOV Circle rigidly centered on screen
    FOVCircle.Visible = Config.SilentAim and Config.FovToggle
    if FOVCircle.Visible then
        FOVCircle.Position = screenCenter
        FOVCircle.Radius = math.clamp(Config.FovRadius, Config.FovMin, Config.FovMax)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
                local humanoid = character.Humanoid
                if humanoid.Health > 0 then
                    CreateEsp(player)
                    local cache = EspCache[player]
                    local hrp = character.HumanoidRootPart
                    local head = character:FindFirstChild("Head") or hrp
                    
                    local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    
                    if onScreen and Config.Enabled then
                        local headVector = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legVector = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        
                        local height = math.abs(headVector.Y - legVector.Y)
                        local width = height / 2
                        
                        -- Box ESP
                        if Config.Box then
                            cache.Box.Visible = true
                            cache.Box.Size = Vector2.new(width, height)
                            cache.Box.Position = Vector2.new(vector.X - width / 2, headVector.Y)
                        else
                            cache.Box.Visible = false
                        end
                        
                        -- Snaplines (White lines to body)
                        if Config.Snaplines then
                            cache.Snapline.Visible = true
                            cache.Snapline.From = screenCenter
                            cache.Snapline.To = Vector2.new(vector.X, vector.Y)
                        else
                            cache.Snapline.Visible = false
                        end
                        
                        -- Health Display at Feet
                        if Config.HealthBar then
                            cache.Health.Visible = true
                            cache.Health.Text = math.floor(humanoid.Health) .. " HP"
                            cache.Health.Position = Vector2.new(vector.X, legVector.Y + 5)
                        else
                            cache.Health.Visible = false
                        end
                    else
                        for _, obj in pairs(cache) do
                            obj.Visible = false
                        end
                    end
                else
                    RemoveEsp(player)
                end
            else
                RemoveEsp(player)
            end
        end
    end
end)
